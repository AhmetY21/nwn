---
import { absoluteUrl } from "../../utils/format";

const configuredEndpoint = import.meta.env.PUBLIC_WAITLIST_ENDPOINT ?? "";
const waitlistEmail = import.meta.env.PUBLIC_WAITLIST_EMAIL ?? "";
const formSubmitEndpoint = waitlistEmail
  ? `https://formsubmit.co/${encodeURIComponent(waitlistEmail)}`
  : "";
const waitlistEndpoint = configuredEndpoint || formSubmitEndpoint;
const hasEndpoint = waitlistEndpoint.length > 0;
const usesFormSubmit = configuredEndpoint.length === 0 && formSubmitEndpoint.length > 0;
const thankYouUrl = absoluteUrl("/tesekkurler");
---

<section class="rounded-[2rem] border border-border bg-surface p-6 shadow-card md:p-8">
  <div class="max-w-2xl">
    <p class="eyebrow">Bekleme listesi</p>
    <h2 class="mt-3 text-3xl leading-tight md:text-4xl">
      Yeni yazılar, kaynaklar ve ürün haberleri hazır olduğunda ilk sen duy.
    </h2>
    <p class="mt-4 text-muted">
      Paylaştığımız içerikler sana daha fazla kural vermek için değil, yemekle ilişkinde daha fazla netlik ve nefes alanı açmak için burada.
    </p>
  </div>

  {
    hasEndpoint ? (
      <form
        method="post"
        action={waitlistEndpoint}
        class="mt-8 grid gap-5 md:grid-cols-2"
      >
        {usesFormSubmit ? (
          <>
            <input type="hidden" name="_subject" value="vivência bekleme listesi" />
            <input type="hidden" name="_template" value="table" />
            <input type="hidden" name="_captcha" value="false" />
            <input type="hidden" name="_next" value={thankYouUrl} />
          </>
        ) : null}
        <div>
          <label class="mb-2 block text-sm font-medium" for="name">
            Adın
          </label>
          <input
            id="name"
            name="name"
            type="text"
            autocomplete="name"
            class="focus-ring w-full rounded-2xl border border-border bg-bg px-4 py-3"
          />
        </div>
        <div>
          <label class="mb-2 block text-sm font-medium" for="email">
            E-posta adresin
          </label>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
            class="focus-ring w-full rounded-2xl border border-border bg-bg px-4 py-3"
          />
        </div>
        <div class="md:col-span-2">
          <label class="mb-2 block text-sm font-medium" for="motivation">
            Bu alanda en çok neyi arıyorsun?
          </label>
          <textarea
            id="motivation"
            name="motivation"
            rows="4"
            class="focus-ring w-full rounded-2xl border border-border bg-bg px-4 py-3"
          ></textarea>
        </div>
        <div class="md:col-span-2 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
          <p class="text-sm text-muted">
            Form yalnızca gerekli iletişim bilgilerini toplar. İstediğin zaman listeden ayrılabilirsin.
          </p>
          <button
            type="submit"
            class="focus-ring inline-flex items-center justify-center rounded-full border border-accent bg-accent px-6 py-3 text-sm font-medium text-bg transition-colors hover:border-text hover:bg-text"
          >
            Listeye katıl
          </button>
        </div>
      </form>
    ) : (
      <div class="mt-8 rounded-[1.5rem] border border-dashed border-border bg-bg p-6">
        <p class="font-medium">
          Bekleme listesi formu neredeyse hazır.
        </p>
        <p class="mt-3 text-sm text-muted">
          Yayına almak için bir alıcı e-posta adresi ya da form servisi bağlantısı tanımlanması yeterli.
        </p>
      </div>
    )
  }
</section>
