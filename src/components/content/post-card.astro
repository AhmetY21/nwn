---
import { CATEGORY_LABELS } from "../../consts";
import type { PostEntry } from "../../utils/content";
import { formatDate, withBase } from "../../utils/format";
import Tag from "../ui/tag.astro";

interface Props {
  post: PostEntry;
}

const { post } = Astro.props;
const href = withBase(`/makaleler/${post.slug}`);
---

<article class="group overflow-hidden rounded-[1.75rem] border border-border bg-surface shadow-card transition-transform duration-300 hover:-translate-y-1">
  <a href={href} class="focus-ring block">
    <img
      src={post.data.coverImage}
      alt={post.data.coverImageAlt}
      loading="lazy"
      decoding="async"
      referrerpolicy="no-referrer-when-downgrade"
      class="aspect-[16/10] w-full object-cover"
    />
    <div class="space-y-4 p-6">
      <div class="flex flex-wrap items-center gap-3">
        <Tag>{CATEGORY_LABELS[post.data.category]}</Tag>
        <span class="text-sm text-muted">{formatDate(post.data.publishDate)}</span>
      </div>
      <div>
        <h3 class="text-2xl leading-tight">{post.data.title}</h3>
        <p class="mt-3 text-base text-muted">{post.data.description}</p>
      </div>
      <div class="flex flex-wrap gap-2">
        {post.data.tags.map((tag) => <Tag>{tag}</Tag>)}
      </div>
      <p class="text-xs text-muted">
        Görsel kaynağı: {post.data.coverImageCreditName}
      </p>
      <p class="text-sm font-medium text-accent">Yazıyı oku</p>
    </div>
  </a>
</article>
