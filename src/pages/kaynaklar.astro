---
import ButtonLink from "../components/ui/button-link.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Kaynaklar | vivência";
const description =
  "Diyet kültürü, sezgisel beslenme ve beden farkındalığı üzerine başlangıç niteliğinde güvenilir kaynaklar.";

const resources = [
  {
    title: "Outcomes of intuitive eating interventions",
    description:
      "Sezgisel beslenme müdahalelerini sistematik olarak derleyen ve erken dönem sonuçlarını değerlendiren meta-analiz.",
    href: "https://pubmed.ncbi.nlm.nih.gov/35400300/"
  },
  {
    title: "Interoception and disordered eating",
    description:
      "Beden sinyallerini fark etme becerisi ile yeme davranışı arasındaki bağlantıyı sistematik olarak inceleyen derleme.",
    href: "https://pubmed.ncbi.nlm.nih.gov/31454626/"
  },
  {
    title: "A systematic review of the psychosocial correlates of intuitive eating among adult women",
    description:
      "Sezgisel beslenmenin beden imgesi, duygusal işleyiş ve yeme davranışlarıyla ilişkisine odaklanan derleme.",
    href: "https://pubmed.ncbi.nlm.nih.gov/26474781/"
  },
  {
    title: "Türkiye Psikiyatri Derneği: Yeme bozuklukları",
    description:
      "Klinik belirti ve risk durumlarında profesyonel yardımın neden önemli olduğunu anlatan halka yönelik bilgi sayfası.",
    href: "https://psikiyatri.org.tr/halka-yonelik/32/yeme-bozukluklari"
  }
];
---

<BaseLayout title={title} description={description} pathname="/kaynaklar">
  <section class="container-shell py-14 md:py-20">
    <div class="mx-auto max-w-3xl">
      <p class="eyebrow">Kaynaklar</p>
      <h1 class="mt-4 text-5xl leading-tight md:text-6xl">
        Başlangıç için güvenilir okuma ve destek bağlantıları
      </h1>
      <p class="mt-6 text-lg text-muted">
        Bu liste tamamlanmış bir literatür taraması değil. Ama reklam dili yerine araştırma ve profesyonel rehberlik arayan biri için sağlam bir ilk durak olabilir.
      </p>
      <p class="mt-4 text-base text-muted">
        Buradaki fark şu: <strong class="text-text">makaleler</strong> bu kaynakları yorumlayan ve gündelik deneyime bağlayan editoryal yazılar; <strong class="text-text">kaynaklar</strong> ise doğrudan başvurulacak çalışma ve kurum bağlantılarıdır.
      </p>
    </div>
  </section>

  <section class="container-shell pb-14 md:pb-20">
    <div class="grid gap-6">
      {
        resources.map((resource) => (
          <article class="rounded-[1.75rem] border border-border bg-surface p-7 shadow-card">
            <h2 class="text-2xl leading-tight">{resource.title}</h2>
            <p class="mt-3 max-w-3xl text-muted">{resource.description}</p>
            <div class="mt-5">
              <ButtonLink href={resource.href} variant="secondary">
                Kaynağı aç
              </ButtonLink>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
