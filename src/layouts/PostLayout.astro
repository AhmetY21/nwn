---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import Prose from "../components/content/prose.astro";
import ButtonLink from "../components/ui/button-link.astro";
import Tag from "../components/ui/tag.astro";
import { CATEGORY_LABELS, SITE } from "../consts";
import { absoluteUrl, formatDate } from "../utils/format";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const articleUrl = absoluteUrl(`/makaleler/${post.slug}`);
const coverImageUrl = post.data.coverImage;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.publishDate).toISOString(),
  inLanguage: "tr-TR",
  image: [coverImageUrl],
  author: {
    "@type": "Person",
    name: post.data.author
  },
  publisher: {
    "@type": "Organization",
    name: SITE.name,
    url: SITE.url
  },
  mainEntityOfPage: articleUrl
};
---

<BaseLayout
  title={`${post.data.title} | ${SITE.name}`}
  description={post.data.description}
  pathname={`/makaleler/${post.slug}`}
  image={coverImageUrl}
  structuredData={structuredData}
>
  <article class="container-shell py-14 md:py-20">
    <header class="mx-auto max-w-3xl border-b border-border pb-10">
      <div class="flex flex-wrap items-center gap-3">
        <Tag>{CATEGORY_LABELS[post.data.category]}</Tag>
        {post.data.featured ? <Tag tone="highlight">Öne çıkan</Tag> : null}
      </div>
      <h1 class="mt-6 text-4xl leading-tight md:text-6xl">{post.data.title}</h1>
      <p class="mt-5 max-w-2xl text-lg text-muted md:text-xl">
        {post.data.description}
      </p>
      <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted">
        <span>{formatDate(post.data.publishDate)}</span>
        <span>{post.data.readingTime} dakikalık okuma</span>
        <span>{post.data.author}</span>
      </div>
    </header>

    <div class="mx-auto mt-10 max-w-4xl overflow-hidden rounded-[2rem] border border-border bg-surface shadow-card">
      <img
        src={coverImageUrl}
        alt={post.data.coverImageAlt}
        loading="eager"
        decoding="async"
        referrerpolicy="no-referrer-when-downgrade"
        class="aspect-[16/10] h-auto w-full object-cover"
      />
    </div>
    <p class="mx-auto mt-3 max-w-4xl text-sm text-muted">
      Görsel:
      <a
        href={post.data.coverImageCreditUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="focus-ring rounded-sm underline decoration-border underline-offset-4 transition-colors hover:text-accent"
      >
        {post.data.coverImageCreditName}
      </a>
      / Unsplash
    </p>

    <Prose>
      <slot />
    </Prose>

    <section class="mx-auto mt-14 max-w-[65ch] rounded-[2rem] border border-border bg-surface p-7 shadow-card">
      <p class="eyebrow">Sonraki adım</p>
      <h2 class="mt-3 text-3xl leading-tight">
        Yazıları takip etmek istiyorsan bekleme listesi en sakin yol.
      </h2>
      <p class="mt-4 text-muted">
        Yeni makaleler, kaynak seçkileri ve ileride açılacak ürün güncellemelerini toplu ve seyrek bir akışla paylaşacağız.
      </p>
      <div class="mt-6 flex flex-wrap gap-4">
        <ButtonLink href="/bekleme-listesi" variant="primary">
          Bekleme listesine katıl
        </ButtonLink>
        <ButtonLink href="/kaynaklar" variant="secondary">
          Kaynaklara göz at
        </ButtonLink>
      </div>
    </section>
  </article>
</BaseLayout>
